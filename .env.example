# ─── BrightData ─────────────────────────────────────────────────────────────
# API token (Account settings -> API tokens)
BRIGHTDATA_API_KEY= 
# Web Unlocker zone name (Zones -> your unlocker zone)
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
# SERP zone name (leave BLANK to run search through the Web Unlocker zone instead)
BRIGHTDATA_SERP_ZONE=serp_api1
# Hard cap on billable BrightData requests per calendar month (0 = off).
# Default keeps you under the 5,000 free-tier credits. Needs Redis to count.
BRIGHTDATA_MONTHLY_LIMIT=4800

# ─── Redis ──────────────────────────────────────────────────────────────────
# Local docker default; Upstash etc. also work (rediss://...)
REDIS_URL=redis://127.0.0.1:6379

# ─── LLM provider ───────────────────────────────────────────────────────────
# ollama (default, local) | anthropic | openai
LLM_PROVIDER=ollama
# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
# API fallbacks (only used when LLM_PROVIDER is set to them)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── Behaviour ──────────────────────────────────────────────────────────────
# Skip re-checking a company if it was checked within this many days
CHECK_TTL_DAYS=7
# Concurrent companies processed by the searcher (mind BrightData rate limits)
SEARCH_CONCURRENCY=4
# Cache BrightData responses in Redis for this many hours (0 disables)
RESPONSE_CACHE_HOURS=72
